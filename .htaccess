DirectoryIndex index.php
Options -Indexes

<FilesMatch "^(\.env|\.setup-enabled|\.setup-progress)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>
